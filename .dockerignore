# More info: https://docs.docker.com/engine/reference/builder/#dockerignore-file
# Ignore build and test binaries.
bin/
dist/
# Ignore the cluster checkouts, which are large and not needed by any image.
_cluster-up/
_cluster-up.tmp/
_kubevirt/
_kubevirt.tmp/
# Of the build output only the controller image needs the rendered manifests.
_out/*
!_out/manifests.yaml
.git/
